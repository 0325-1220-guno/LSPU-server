{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run website on port 8080",
      "type": "shell",
      "command": "python3 -m http.server 8080 --bind 0.0.0.0",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on .* port 8080",
          "endsPattern": "^Serving HTTP on .* port 8080"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
